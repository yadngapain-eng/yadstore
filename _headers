# ============================================
# CLOUDFLARE PAGES HEADERS
# ============================================

/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/icons/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800, immutable
  Access-Control-Allow-Origin: *

/icons/*.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=604800, immutable
  Access-Control-Allow-Origin: *

/icons/*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800, immutable
  Access-Control-Allow-Origin: *

/icons/*.jpeg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800, immutable
  Access-Control-Allow-Origin: *

/icons/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=604800, immutable
  Access-Control-Allow-Origin: *

/css/*.css
  Content-Type: text/css
  Cache-Control: public, max-age=604800, immutable

/js/*.js
  Content-Type: application/javascript
  Cache-Control: public, max-age=604800, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(self), camera=()
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https: *.profitableratecpmnetwork.com *.googletagmanager.com *.google-analytics.com *.gstatic.com *.googleapis.com *.telegram.org *.firebaseio.com; style-src 'self' 'unsafe-inline' https: *.googleapis.com; img-src 'self' data: blob: https: *.profitableratecpmnetwork.com *.telegram.org *.google-analytics.com; connect-src 'self' https: wss: data: blob: *.profitableratecpmnetwork.com *.google-analytics.com *.telegram.org *.firebaseio.com *.googleapis.com; font-src 'self' data: https: fonts.gstatic.com; frame-src 'self' https: *.profitableratecpmnetwork.com *.telegram.org; worker-src 'self' blob: https:; child-src 'self' blob: https:; media-src 'self' https: blob: data:
